'GoofBall fix: Legendary Monuments 8.2 runs this for every NPC. NPCs without this config variable (RCT trainers) give 0 instead of a string and q.is_blank crashed the server. The battle-repeat block is limited to this NPC (via its reward toggle): for RCT trainers !toggle_battle_repeat was true and set_npc_variable crashed on a non-NPC.';
for_each(t.loser, c.npc_losers, {
  (t.loser.npc.config.quest_update_on_player_wins != 0 ? !q.is_blank(t.loser.npc.config.quest_update_on_player_wins) : 0) ? {
    for_each(t.player_winner, c.player_winners, {
      v.player = t.player_winner.player;
      v.npc = t.loser.npc;
      q.set_query('player', t.player_winner.player);
      q.set_query('npc', t.loser.npc);
      q.run_molang(t.loser.npc.config.quest_update_on_player_wins);
    });
  };

  (t.loser.npc.config.toggle_archie_battle_reward && !t.loser.npc.config.toggle_battle_repeat) ? {
    for_each(t.player_winner, c.player_winners, {
      v.player = t.player_winner.player;
      v.npc = t.loser.npc;
      q.set_query('player', t.player_winner.player);
      q.set_query('npc', t.loser.npc);
      
      q.player.set_npc_variable(t.loser.npc, 'defeated', 1.0);
      q.player.save_data();
    });
  };

  t.loser.npc.config.toggle_lm_archie_battle_reward ? {
    for_each(t.player_winner, c.player_winners, {
      v.player = t.player_winner.player;
      v.npc = t.loser.npc;
      q.set_query('player', t.player_winner.player);
      q.set_query('npc', t.loser.npc);
      q.run_command('loot give ' + q.player.username + ' loot legendarymonuments:archie_rewards');
    });
  };
});